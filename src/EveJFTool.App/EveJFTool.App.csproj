<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EveJFTool.Core\EveJFTool.Core.csproj" />
    <ProjectReference Include="..\EveJFTool.Data\EveJFTool.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EveJFTool</AssemblyName>
    <Version>1.2.0</Version>
    <Authors>Mythandar</Authors>
    <Product>EVE Jump Ship Calculator</Product>
    <Description>Windows route, isotope-use, and fuel-cost calculator for EVE Online jump-drive ships.</Description>
    <RepositoryUrl>https://github.com/Mythandar/EveJFTool</RepositoryUrl>
  </PropertyGroup>

</Project>

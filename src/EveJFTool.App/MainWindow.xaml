<Window x:Class="EveJFTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Jump Freighter Calculator"
        Width="1400" Height="850" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D1522" Foreground="#E8EDF4"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#172235" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3A50" />
        <SolidColorBrush x:Key="AccentBrush" Color="#35C7A6" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#26364C" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#40536E" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#B9C5D6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="#29384C" />
            <Setter Property="Foreground" Value="#E8EDF4" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Label Content="Ship" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Ships}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedShip}" />
                <Label Grid.Column="2" Content="JDC" ToolTip="Jump Drive Calibration" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding JumpDriveCalibration}" />
                <Label Grid.Column="4" Content="JFC" ToolTip="Jump Fuel Conservation" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding JumpFuelConservation}" />
                <Label Grid.Column="6" Content="JF" ToolTip="Jump Freighters" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding JumpFreighters}" />
                <Label Grid.Column="9" Content="Price" />
                <ComboBox Grid.Column="10" ItemsSource="{Binding PriceModes}" SelectedItem="{Binding SelectedPriceMode}" />
                <Button Grid.Column="11" Content="Refresh Prices" HorizontalAlignment="Left" Command="{Binding RefreshPricesCommand}" Margin="10,2,3,2" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Orientation="Horizontal" Margin="2,8,0,0">
                    <TextBlock Text="Maximum jump range: " Foreground="#8FA1B8" />
                    <TextBlock Text="{Binding MaximumRangeText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding SelectedFuelType}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="#65768D" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PriceValueText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Width="125" Margin="12,0,0,0" Text="{Binding ManualPrice, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsManualPrice, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Manual ISK per isotope" />
                    <TextBlock Text="  " />
                    <TextBlock Text="{Binding PriceSourceText}" Foreground="#AEBBD0" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="#65768D" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PriceUpdatedText}" Foreground="#8FA1B8" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="New Route" Command="{Binding NewRouteCommand}" />
                    <Button Content="Add Return Trip" Command="{Binding AddReturnTripCommand}"
                            AutomationProperties.AutomationId="AddReturnTripButton"
                            ToolTip="Append the current route in reverse, preserving each leg's settings" />
                    <ComboBox Width="220" ItemsSource="{Binding SavedRoutes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSavedRoute}" ToolTip="Saved routes" />
                    <Button Content="Load Route" Command="{Binding LoadRouteCommand}" />
                    <Button Content="Delete Route" Command="{Binding DeleteRouteCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Route name" />
                    <TextBox Width="220" Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Save Route" Command="{Binding SaveRouteCommand}" />
                    <Button Content="Save As" Command="{Binding SaveAsRouteCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="ROUTE SYSTEMS" FontSize="12" FontWeight="Bold" Foreground="#8FA1B8" Margin="4,2,4,8" />
                    <TextBox x:Name="SystemSearchBox" Grid.Row="1"
                             Text="{Binding NewSystemName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SystemSearchBox"
                             ToolTip="Type at least two characters from an EVE solar-system name" />
                    <Popup Grid.Row="1" PlacementTarget="{Binding ElementName=SystemSearchBox}" Placement="Bottom"
                           IsOpen="{Binding IsSystemSuggestionOpen, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True" Focusable="False">
                        <Border Width="{Binding ActualWidth, ElementName=SystemSearchBox}"
                                MaxHeight="300" Background="#172235" BorderBrush="#40536E"
                                BorderThickness="1" CornerRadius="3">
                            <ListBox ItemsSource="{Binding SystemSuggestions}"
                                     SelectedItem="{Binding SelectedSystemSuggestion, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="SystemSuggestionList"
                                     Background="#172235" Foreground="#E8EDF4" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Padding" Value="7,5" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" DisplayMemberPath="Name"
                             AutomationProperties.AutomationId="RouteSystemList"
                             Margin="4,8" Background="#101A29" Foreground="#E8EDF4" BorderBrush="#314158" FontSize="14">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <WrapPanel Grid.Row="3">
                        <Button Content="Add" Command="{Binding AddSystemCommand}" />
                        <Button Content="Insert" Command="{Binding InsertSystemCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveSystemCommand}" />
                        <Button Content="↑" Command="{Binding MoveSystemUpCommand}" ToolTip="Move selected system up" />
                        <Button Content="↓" Command="{Binding MoveSystemDownCommand}" ToolTip="Move selected system down" />
                        <Button Content="Clear" Command="{Binding ClearRouteCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DataGrid ItemsSource="{Binding Legs}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#101A29" RowBackground="#101A29"
                          AlternatingRowBackground="#142033" HorizontalGridLinesBrush="#29384C" BorderBrush="#314158"
                          SelectionMode="Single" SelectionUnit="FullRow" FrozenColumnCount="2">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#E8EDF4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Background" Value="#6A2030" />
                                    <Setter Property="ToolTip" Value="{Binding Status}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="From" Binding="{Binding From}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="To" Binding="{Binding To}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="Distance (LY)" Binding="{Binding Distance}" IsReadOnly="True" Width="105" />
                        <DataGridTemplateColumn Header="Jump / Gate" Width="105">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding LegKinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Economizer 1" Width="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding EconomizerTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Economizer1, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsJump}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Economizer 2" Width="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding EconomizerTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Economizer2, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsJump}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Economizer 3" Width="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding EconomizerTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Economizer3, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsJump}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Fuel Used" Binding="{Binding FuelUsed}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" IsReadOnly="True" Width="135" />
                        <DataGridTextColumn Header="Fuel Price" Binding="{Binding FuelPrice}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="ISK Cost" Binding="{Binding IskCost}" IsReadOnly="True" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*" MinWidth="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="JUMP LEGS" Foreground="#8FA1B8" FontSize="11" /><TextBlock Text="{Binding JumpLegsText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="GATE LEGS" Foreground="#8FA1B8" FontSize="11" /><TextBlock Text="{Binding GateLegsText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="JUMP DISTANCE" Foreground="#8FA1B8" FontSize="11" /><TextBlock Text="{Binding TotalDistanceText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="ISOTOPES" Foreground="#8FA1B8" FontSize="11" /><TextBlock Text="{Binding TotalFuelText}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="FUEL COST" Foreground="#8FA1B8" FontSize="11" /><TextBlock Text="{Binding TotalCostText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#101A29" BorderBrush="#27364A" BorderThickness="1" CornerRadius="4" Padding="8,6">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#B9C5D6" />
                <TextBlock DockPanel.Dock="Right" Text="Calculations update automatically" Foreground="#65768D" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
